.env
.venv/
storage/
__pycache__/
*.pyc
.pytest_cache/
.DS_Store

# Course-supplied ticket sets are not committed: the submission guide asks for
# small samples only. data/sample_tickets.json is committed for the smoke test.
# data/documentation.json IS committed, at 40KB: it is the knowledge base the
# application reads to ground every answer, so a checkout without it cannot
# work at all. That is application data rather than test data.
data/development_tickets.json
data/validation_tickets.json
data/ground_truth_responses.json

# Run output is regenerated by the harness, so exploratory runs stay out. The two
# runs the report quotes are committed, because the submission guide asks evaluation/
# to hold the results and not only the harness, and because Appendix C cites them.
#
# decisions.db is excluded even for those two runs. It stores each ticket's subject
# and body, so committing it to a public repository would republish the course's
# validation set in another form, which is the same reason the ticket JSON files are
# not here. outcomes.jsonl carries the per-ticket decisions with no ticket text, and
# the harness rebuilds the log on any run.
evaluation/results/**
!evaluation/results/.gitkeep
!evaluation/results/validation_01/
!evaluation/results/validation_01/metrics.md
!evaluation/results/validation_01/metrics.json
!evaluation/results/validation_01/outcomes.jsonl
!evaluation/results/outage/
!evaluation/results/outage/metrics.md
!evaluation/results/outage/metrics.json
!evaluation/results/outage/outcomes.jsonl

# Build intermediate for the report PDF.
docs/report.html
