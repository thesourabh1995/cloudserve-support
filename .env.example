# Copy this file to .env and fill in your own values.
# .env is gitignored. Never put a real key in this file.

# Model access. Supported providers: groq, openrouter.
# Groq is the default: its free tier allows 14,400 requests a day against
# OpenRouter's 50, and a full run over the ticket set needs roughly a thousand.
# Get a key at https://console.groq.com/keys (no card required).
LLM_PROVIDER=groq
GROQ_API_KEY=your_key_here
MODEL_NAME=llama-3.1-8b-instant

# Only needed if you set LLM_PROVIDER=openrouter.
# OPENROUTER_API_KEY=your_key_here

EMBEDDING_MODEL=all-MiniLM-L6-v2

CHROMA_PATH=./storage/chroma
DATABASE_URL=sqlite:///./storage/decisions.db

LOG_LEVEL=INFO
CONFIDENCE_THRESHOLD=0.80
RETRIEVAL_TOP_K=5
