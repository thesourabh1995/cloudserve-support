# Copy this file to .env and fill in your own values.
# .env is gitignored. Never put a real key in this file.

# Model access. Supported providers: groq, openrouter.
# Groq is the default: its free tier allows 1,000 requests a day against
# OpenRouter's 50, and a full pass over the ticket set needs roughly 800.
# Get a key at https://console.groq.com/keys (no card required).
# The model was chosen by measurement; see docs/model_choice.md.
LLM_PROVIDER=groq
GROQ_API_KEY=your_key_here
MODEL_NAME=openai/gpt-oss-20b

# Only needed if you set LLM_PROVIDER=openrouter.
# OPENROUTER_API_KEY=your_key_here

EMBEDDING_MODEL=all-MiniLM-L6-v2

CHROMA_PATH=./storage/chroma
DATABASE_URL=sqlite:///./storage/decisions.db

LOG_LEVEL=INFO
CONFIDENCE_THRESHOLD=0.80
RETRIEVAL_TOP_K=5

# The stop control. Creating this file halts automatic answering from the next
# ticket onward, with no restart. Setting the path here is for deployment; the
# switch is operated by creating or deleting the file, not by editing config.
# See docs/governance.md.
KILL_SWITCH_FILE=./storage/STOP_AUTOMATION
